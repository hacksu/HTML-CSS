# HTML-CSS Tutorial Project .gitignore

# ===========================================
# Operating System Files
# ===========================================

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ===========================================
# Editor and IDE Files
# ===========================================

# Visual Studio Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# JetBrains IDEs
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc

# ===========================================
# Web Development
# ===========================================

# Node modules (if you add Node.js later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# Build outputs (if you add build tools later)
dist/
build/
out/

# CSS preprocessors
*.css.map
*.sass.cache
*.scss.cache

# ===========================================
# Project-Specific
# ===========================================

# Finished examples (keep this if you don't want students to see solutions)
finished-portfolio-example/

# Student work directories (uncomment if you want to ignore student submissions)
# student-submissions/
# student-work/

# Temporary files
*.tmp
*.temp
temp/
tmp/

# Backup files
*.bak
*.backup
*_backup.*

# Log files
*.log
logs/

# ===========================================
# Archives and Compressed Files
# ===========================================
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz

# ===========================================
# Documentation and Notes
# ===========================================

# Personal notes (uncomment if you have private instructor notes)
# instructor-notes.md
# private-notes/
# lesson-plans/

# ===========================================
# Images and Media (Large Files)
# ===========================================

# Uncomment these if you want to ignore large media files
# *.mp4
# *.avi
# *.mov
# *.wmv
# *.flv
# *.webm

# Large images (uncomment if needed)
# *.psd
# *.ai
# *.sketch
/finished-portoflio-example
